# PRISMA POS - Database & Application Configuration
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=21970
DB_USER=avnadmin
DB_PASSWORD=YOUR_AIVEN_PASSWORD
DB_NAME=defaultdb
DB_SSL=true
PORT=5001
JWT_SECRET=your_jwt_secret_key_change_in_production

# SMTP Mailer Configuration (Gmail or Corporate SMTP for OTP verification)
# For Gmail: Use smtp.gmail.com, port 587, and an App Password (16 characters)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="PRISMA POS Kedinasan" <noreply@posindonesia.co.id>
